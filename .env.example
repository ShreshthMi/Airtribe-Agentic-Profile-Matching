# Copy to .env and add your Anthropic API key. Never commit .env.
ANTHROPIC_API_KEY=

# Optional (real environment variables take precedence)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# Only for an API key that spans several workspaces; workspace-scoped keys don't need it.
# ANTHROPIC_WORKSPACE_ID=

# Round 1 embeddings (see embedders.py). Build the matching index with
#   python scripts/build_index.py --provider <provider>
# huggingface (default, local MiniLM) | ollama (local, no key) | voyage | openai
# EMBEDDING_PROVIDER=huggingface
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
