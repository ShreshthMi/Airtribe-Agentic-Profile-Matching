# Copy to .env and add your Anthropic API key. Never commit .env.
ANTHROPIC_API_KEY=

# Optional (real environment variables take precedence)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium
# Only for an API key that spans several workspaces; workspace-scoped keys don't need it.
# ANTHROPIC_WORKSPACE_ID=
